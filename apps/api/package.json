    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.22",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.7.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.4",
    "vitest": "^3.1.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
