// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  account   String   @unique
  email     String?  @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servicesCreated Service[] @relation("ServiceCreatedBy")
  ticketsCreated  Ticket[]  @relation("TicketCreatedBy")
  ticketsAssigned Ticket[]  @relation("TicketAssignee")
  ticketLogs      TicketLog[]
  feedbacks       TicketFeedback[]
}

model Model {
  id          String   @id @default(uuid())
  name        String
  provider    String
  baseUrl     String?
  apiKey      String?
  temperature Float?   @default(0.7)
  topP        Float?   @default(1.0)
  maxTokens   Int?     @default(2048)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]       @relation("TaskModels")
  taskResults TaskResult[]
  agents      Agent[]
}

model Question {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    Message[]
  tasks       Task[]       @relation("TaskQuestions")
  taskResults TaskResult[]
}

model Message {
  id         String   @id @default(uuid())
  role       String // 'system', 'user', 'assistant'
  content    String
  questionId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Task {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("pending") // 'pending', 'running', 'completed', 'failed'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models    Model[]      @relation("TaskModels")
  questions Question[]   @relation("TaskQuestions")
  results   TaskResult[]
}

model TaskResult {
  id             String   @id @default(uuid())
  taskId         String
  modelId        String
  questionId     String
  response       String?
  timeTaken      Int? // in ms
  firstTokenTime Int? // in ms
  tokensUsed     Int?
  status         String   @default("success") // 'success', 'error'
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  model    Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Agent {
  id           String   @id @default(uuid())
  name         String
  description  String?
  systemPrompt String?
  modelId      String
  workflow     String? // Store as JSON string since SQLite doesn't support Json type natively, or Json if Prisma supports it.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  model Model @relation(fields: [modelId], references: [id])
}

model ApiKey {
  id              String   @id @default(uuid())
  key             String   @unique
  name            String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  totalTokensUsed Int      @default(0)
}

model Process {
  id          String   @id @default(uuid())
  name        String
  description String?
  communities String?  @default("[]")
  status      String?  @default("active")
  timeLimit   Int?     @default(24)
  nodes       String
  edges       String
  formConfig  String?  @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  services Service[]
  tickets  Ticket[]
}

model Service {
  id          String   @id @default(uuid())
  processId   String
  name        String
  description String?
  config      String?  @default("{}")
  enabled     Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tickets   Ticket[]

  @@unique([processId, name])
  @@index([processId])
  @@index([createdById])
}

model Ticket {
  id          String   @id @default(uuid())
  ticketNo    String
  title       String
  description String?
  status      String   @default("open")
  priority    String?
  processId   String
  serviceId   String
  createdById String
  assigneeId  String?
  formData    String?  @default("{}")
  closedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdBy User    @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  assignee  User?   @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  tasks TicketTask[]
  logs  TicketLog[]
  feedback TicketFeedback?

  @@unique([ticketNo])
  @@index([processId])
  @@index([serviceId])
  @@index([createdById])
  @@index([assigneeId])
  @@index([status])
}

model TicketFeedback {
  id          String   @id @default(uuid())
  ticketId    String   @unique
  userId      String?
  rating      Int      @default(5)
  content     String?
  tags        String?  @default("[]") // JSON string array
  callback    String?  // callback notes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([rating])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  type      String   @default("department") // 'community', 'project', 'department'
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Organization[] @relation("OrgHierarchy")
  
  @@index([parentId])
}

model Role {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TicketTask {
  id         String   @id @default(uuid())
  ticketId   String
  name       String
  nodeKey    String?
  status     String   @default("pending")
  input      String?  @default("{}")
  output     String?  @default("{}")
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticket Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  logs   TicketLog[]

  @@index([ticketId])
  @@index([nodeKey])
  @@index([status])
}

model TicketLog {
  id        String   @id @default(uuid())
  ticketId  String
  taskId    String?
  userId    String?
  level     String   @default("info")
  action    String?
  message   String
  meta      String?  @default("{}")
  createdAt DateTime @default(now())

  ticket Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  task   TicketTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user   User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}
